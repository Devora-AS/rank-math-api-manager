# WordPress Plugin .gitignore

# Test output (test harness under tests/ is committed)
tests/coverage/
.playwright-cli/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
.cursor/*
.worktrees/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Node modules (if using build tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build directories
build/
dist/
assets/build/
rank-math-api-manager/

# Composer (lock file is committed; vendor is not)
vendor/

# Environment files (live credentials; samples stay trackable via negations below)
.env
.env.*
.mat.env
.mat.env.local
.mat.env.*

# WordPress specific
wp-config.php
wp-content/uploads/
wp-content/cache/
wp-content/backup-db/
wp-content/backups/
wp-content/blogs.dir/
wp-content/upgrade/
wp-content/uploads/
wp-content/mu-plugins/
wp-content/wp-cache-config.php
wp-content/plugins/hello.php

# Plugin specific
*.zip
*.tar.gz
*.tar.bz2
/deploy.sh
/wp-local.sh
/.deployignore
agent-skills/
*.code-workspace
transcripts/
agent-transcripts/
local-notes/
.notes/

# Testing
coverage/
.phpunit.result.cache
tests/coverage/

# Documentation build
docs/_build/
docs/.doctrees/

# Backup files
*.sql
*.sql.gz
*.sql.bz2

# Cache files
cache/
*.cache

# Temporary uploads
uploads/temp/

# MAT runtime exhaust (local verification, MAO hooks)
artifacts/
.mat/tests/__pycache__/

# BEGIN MAT git tracking
!.cursor/agents/
!.cursor/commands/
!.cursor/hooks/
!.cursor/rules/
!.cursor/scripts/
!.cursor/hooks.json
!.cursor/worktrees.json
!.cursor/skills/
build-result.md
verify-result.md
!.env.sample
!**/.env.sample
!.mat.env.sample
!**/.mat.env.sample
.cursor/mcp.json
.cursor/settings.json
.cursor/cache/
.cursor/plans/
.cursor/hooks/state/
**/__pycache__/
*.py[cod]
# END MAT git tracking
