      "never_overwrite_root": [],
      "install_product_readme_stub_if_missing": true,
      "install_product_agents_if_missing": true,
      "overwrite_root_agents_if_missing_only": true
    },
    "existing-project": {
      "never_overwrite_root": [
        "README.md",
        "CHANGELOG.md",
        "AGENTS.md"
      ],
      "install_product_readme_stub_if_missing": true,
      "install_product_agents_if_missing": true,
      "overwrite_root_agents_if_missing_only": true
    }
  },
