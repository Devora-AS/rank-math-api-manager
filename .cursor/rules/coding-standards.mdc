```

### 2. REST API Registration

```php
/**
 * Register REST API routes
 */
public function register_rest_routes() {
    register_rest_route('rank-math-api/v1', '/update-meta', array(
        'methods'             => 'POST',
        'callback'            => array($this, 'update_meta_callback'),
        'permission_callback' => array($this, 'check_permissions'),
        'args'                => array(
            'post_id' => array(
                'required'          => true,
                'validate_callback' => array($this, 'validate_post_id'),
                'sanitize_callback' => 'intval',
            ),
            'meta_data' => array(
                'required'          => true,
                'validate_callback' => array($this, 'validate_meta_data'),
                'sanitize_callback' => array($this, 'sanitize_meta_data'),
            ),
        ),
    ));
}
```

### 3. Script and Style Enqueuing

```php
/**
 * Enqueue admin scripts and styles
 */
public function enqueue_admin_scripts($hook) {
    if ('settings_page_rank-math-api' !== $hook) {
        return;
    }

    wp_enqueue_script(
        'rank-math-api-admin',
        plugin_dir_url(__FILE__) . 'js/admin.js',
        array('jquery'),
        self::VERSION,
        true
    );

    wp_enqueue_style(
        'rank-math-api-admin',
        plugin_dir_url(__FILE__) . 'css/admin.css',
        array(),
        self::VERSION
    );

    wp_localize_script('rank-math-api-admin', 'rankMathApi', array(
        'ajaxUrl' => admin_url('admin-ajax.php'),
        'nonce'   => wp_create_nonce('rank_math_api_nonce'),
    ));
}
```

## 🛡️ Security Implementation

### 1. Input Validation

```php
/**
 * Validate post ID
 *
 * @param mixed $value The value to validate
 * @return bool|WP_Error
 */
public function validate_post_id($value) {
    $post_id = intval($value);

    if (!$post_id || $post_id <= 0) {
        return new WP_Error('invalid_post_id', 'Invalid post ID');
    }

    if (!get_post($post_id)) {
        return new WP_Error('post_not_found', 'Post not found');
    }

    return true;
}

/**
 * Sanitize meta data
 *
 * @param mixed $value The value to sanitize
 * @return array
 */
public function sanitize_meta_data($value) {
    if (!is_array($value)) {
        return array();
    }

    $sanitized = array();

    foreach ($value as $key => $data) {
        $sanitized[$key] = sanitize_text_field($data);
    }

    return $sanitized;
}
```

### 2. Capability Checks

```php
/**
 * Check user permissions
 *
 * @param WP_REST_Request $request The request object
 * @return bool|WP_Error
 */
public function check_permissions($request) {
    if (!is_user_logged_in()) {
        return new WP_Error('not_logged_in', 'User not logged in', array('status' => 401));
    }

    if (!current_user_can('edit_posts')) {
        return new WP_Error('insufficient_permissions', 'Insufficient permissions', array('status' => 403));
    }

    return true;
}
```

## 📊 Database Operations

### 1. Using WordPress Database Functions

```php
/**
 * Update post meta using WordPress functions
 *
 * @param int   $post_id   The post ID
 * @param array $meta_data The meta data to update
 * @return bool
 */
public function update_post_meta($post_id, $meta_data) {
    $updated = true;

    foreach ($meta_data as $meta_key => $meta_value) {
        $result = update_post_meta($post_id, $meta_key, $meta_value);
        if (false === $result) {
            $updated = false;
        }
    }

    return $updated;
}
```

### 2. Custom Database Queries

```php
/**
 * Get posts with specific meta
 *
 * @param string $meta_key   The meta key to search for
 * @param string $meta_value The meta value to search for
 * @return array
 */
public function get_posts_by_meta($meta_key, $meta_value) {
    global $wpdb;

    $query = $wpdb->prepare(
        "SELECT p.ID, p.post_title
         FROM {$wpdb->posts} p
         INNER JOIN {$wpdb->postmeta} pm ON p.ID = pm.post_id
         WHERE pm.meta_key = %s AND pm.meta_value = %s
         AND p.post_status = 'publish'",
        $meta_key,
        $meta_value
    );

    return $wpdb->get_results($query);
}
```

